{
  "name": "@khee/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev --port 6006 --no-open",
    "build": "storybook build --output-dir storybook-static --quiet",
    "lint": "eslint . && stylelint \".storybook/**/*.css\"",
    "typecheck": "tsc",
    "test": "vitest run && node --test \"stories/**/*.test.ts\"",
    "test:visual": "node scripts/visual.ts"
  },
  "devDependencies": {
    "@khee/react": "workspace:*",
    "@khee/tokens": "workspace:*",
    "@storybook/addon-a11y": "10.6.4",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/addon-vitest": "10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.4"
  }
}
