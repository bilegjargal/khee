{
  "name": "@khee/tokens",
  "version": "0.1.0",
  "description": "Design tokens for Khee as one plain CSS file, with light and dark themes and no JavaScript runtime.",
  "keywords": [
    "design-tokens",
    "css",
    "css-custom-properties",
    "design-system",
    "theming",
    "dark-mode"
  ],
  "homepage": "https://github.com/bilegjargal/khee/tree/main/packages/tokens#readme",
  "bugs": {
    "url": "https://github.com/bilegjargal/khee/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bilegjargal/khee.git",
    "directory": "packages/tokens"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./tokens.css": "./dist/tokens.css"
  },
  "sideEffects": [
    "./dist/tokens.css"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "lint": "eslint . && stylelint \"**/*.css\"",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "check:contrast": "node scripts/check-contrast.ts"
  }
}
