{
  "name": "@khee/react",
  "version": "0.0.0",
  "description": "Accessible React components for Khee, built on React Aria Components and styled with plain CSS.",
  "keywords": [
    "react",
    "components",
    "design-system",
    "accessibility",
    "react-aria",
    "css"
  ],
  "homepage": "https://github.com/bilegjargal/khee/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/bilegjargal/khee/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bilegjargal/khee.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!**/*.test.*"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components.css": "./dist/components.css",
    "./reset.css": "./dist/reset.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "typecheck": "tsc && tsc -p scripts",
    "test": "vitest run && node --test \"scripts/**/*.test.ts\"",
    "check:use-client": "node scripts/check-use-client.ts"
  },
  "dependencies": {
    "react-aria-components": "1.22.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@khee/tokens": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
