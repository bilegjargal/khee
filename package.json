    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.3",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "vitest-browser-react": "2.3.0"
  }
